# B' 激活配置模板：复制为 .env 并填值（不要提交 .env 到仓库）
# 激活只需填前两项；其余有默认值。

# 【必填】DeepSeek API key（https://platform.deepseek.com 获取，按 token 充值，无强制会员）
DEEPSEEK_API_KEY=

# 【必填】LME 行情 token（fetch_news.py 用；原 GitHub Actions 同款 secret）
LME_TOKEN=

# 【可选】默认即可
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat
# 数字未落地即中止发布（守门）：1=开 0=关（关则仅告警不卡）
VERIFY_NUMBERS_STRICT=1
# 报告日期 YYYY-MM-DD；留空=今天
REPORT_DATE=
